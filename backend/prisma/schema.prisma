generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FavoriteTargetType {
  DESTINATION
  HOTEL
  EXPERIENCE
}

enum TripItemType {
  DESTINATION
  HOTEL
  EXPERIENCE
}

enum ReservationTargetType {
  DESTINATION
  HOTEL
  EXPERIENCE
  CUSTOM
}

enum ReservationStatus {
  REQUESTED
  REVIEWING
  APPROVED
  DECLINED
  CANCELLED
  COMPLETED
}

enum SubscriptionTier {
  FREE
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
}

model User {
  id                 String                     @id @default(cuid())
  email              String                     @unique
  passwordHash       String
  role               UserRole                   @default(CUSTOMER)
  isActive           Boolean                    @default(true)
  emailVerifiedAt    DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  profile            UserProfile?
  favorites          Favorite[]
  savedTrips         SavedTrip[]
  reservations       Reservation[]
  subscriptions      Subscription[]
  statusChanges      ReservationStatusHistory[] @relation("StatusChangedBy")
  uploadedMedia      MediaAsset[]               @relation("MediaUploadedBy")
  auditLogs          AdminAuditLog[]            @relation("AuditActor")

  @@index([role, isActive])
  @@index([createdAt])
}

model UserProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  firstName      String?
  lastName       String?
  phone          String?
  country        String?
  city           String?
  preferredStyle String?
  avatarUrl      String?
  marketingOptIn Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Destination {
  id              String        @id @default(cuid())
  slug            String        @unique
  name            String
  country         String
  region          String
  category        String
  description     String
  longDescription String
  heroImageUrl    String?
  gallery         Json          @default("[]")
  priceFromCents  Int
  rating          Decimal?      @db.Decimal(2, 1)
  season          String?
  duration        String?
  highlights      Json          @default("[]")
  itinerary       Json          @default("[]")
  coordinates     Json?
  featured        Boolean       @default(false)
  premiumOnly     Boolean       @default(false)
  status          PublishStatus @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  hotels          Hotel[]
  experiences     Experience[]

  @@index([status, featured])
  @@index([region, status])
  @@index([premiumOnly, status])
}

model Hotel {
  id             String        @id @default(cuid())
  destinationId  String
  name           String
  slug           String        @unique
  category       String
  description    String
  address        String?
  heroImageUrl   String?
  gallery        Json          @default("[]")
  priceFromCents Int
  rating         Decimal?      @db.Decimal(2, 1)
  amenities      Json          @default("[]")
  rooms          Json          @default("[]")
  featured       Boolean       @default(false)
  premiumOnly    Boolean       @default(false)
  status         PublishStatus @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  destination    Destination   @relation(fields: [destinationId], references: [id], onDelete: Restrict)

  @@index([destinationId, status])
  @@index([status, featured])
}

model Experience {
  id             String        @id @default(cuid())
  destinationId  String?
  title          String
  slug           String        @unique
  location       String
  category       String
  description    String
  heroImageUrl   String?
  gallery        Json          @default("[]")
  priceFromCents Int
  duration       String?
  inclusions     Json          @default("[]")
  featured       Boolean       @default(false)
  premiumOnly    Boolean       @default(false)
  status         PublishStatus @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  destination    Destination?  @relation(fields: [destinationId], references: [id], onDelete: SetNull)

  @@index([destinationId, status])
  @@index([category, status])
  @@index([status, featured])
}

model Favorite {
  id         String             @id @default(cuid())
  userId     String
  targetType FavoriteTargetType
  targetId   String
  createdAt  DateTime           @default(now())
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([userId, createdAt])
}

model SavedTrip {
  id          String          @id @default(cuid())
  userId      String
  name        String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       SavedTripItem[]

  @@index([userId, updatedAt])
}

model SavedTripItem {
  id         String       @id @default(cuid())
  tripId     String
  itemType   TripItemType
  itemId     String
  sortOrder  Int          @default(0)
  notes      String?
  createdAt  DateTime     @default(now())
  trip       SavedTrip    @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, itemType, itemId])
  @@index([tripId, sortOrder])
}

model Reservation {
  id             String                     @id @default(cuid())
  userId         String
  targetType     ReservationTargetType
  targetId       String?
  status         ReservationStatus          @default(REQUESTED)
  partySize      Int
  preferredStart DateTime?
  preferredEnd   DateTime?
  notes          String?
  priority       Boolean                    @default(false)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  user           User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  history        ReservationStatusHistory[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([priority, status])
}

model ReservationStatusHistory {
  id            String            @id @default(cuid())
  reservationId String
  fromStatus    ReservationStatus?
  toStatus      ReservationStatus
  note          String?
  changedById   String?
  createdAt     DateTime          @default(now())
  reservation   Reservation       @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  changedBy     User?             @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([reservationId, createdAt])
}

model SubscriptionPlan {
  id               String           @id @default(cuid())
  code             SubscriptionTier @unique
  name             String
  description      String
  priceMonthlyCents Int
  favoriteLimit    Int?
  tripLimit        Int?
  features         Json             @default("[]")
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  subscriptions    Subscription[]
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String
  planId                 String
  status                 SubscriptionStatus @default(ACTIVE)
  provider               String?
  providerCustomerId     String?
  providerSubscriptionId String?            @unique
  currentPeriodStart     DateTime            @default(now())
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean             @default(false)
  cancelledAt            DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  user                   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                   SubscriptionPlan    @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([planId, status])
}

model MediaAsset {
  id           String    @id @default(cuid())
  kind         MediaKind @default(IMAGE)
  bucket       String
  objectKey    String    @unique
  contentType  String
  byteSize     Int
  width        Int?
  height       Int?
  altText      String?
  entityType   String?
  entityId     String?
  uploadedById String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  uploadedBy   User      @relation("MediaUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([createdAt])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}
